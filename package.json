{
  "name": "mypi",
  "version": "0.0.1",
  "description": "Personal pi harness: extensions, skills, prompts, and themes for my workflow",
  "license": "MIT",
  "author": "Cenron",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "mypi"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "imports": {
    "#core/*": "./src/core/*.ts",
    "#command/*": "./src/command/*.ts",
    "#tool/*": "./src/tool/*.ts",
    "#module/*": "./src/module/*.ts",
    "#ui/*": "./src/ui/*.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./resources/skills"
    ],
    "prompts": [
      "./resources/prompts/*.md"
    ],
    "themes": [
      "./resources/themes/*.json"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "check": "npm run typecheck && npm run lint && npm run test:cov"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "^22.20.5",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^5.0.4",
    "typebox": "1.3.27",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@mixmark-io/domino": "^2.2.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^8.12.3"
  }
}
